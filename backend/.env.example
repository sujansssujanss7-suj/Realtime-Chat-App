# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.

# ── Server ─────────────────────────────────────────────────────────────────
# Render automatically injects PORT. Leave this as-is locally.
PORT=5000

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Paste your Atlas connection string here.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/realtime-chat?retryWrites=true&w=majority

# ── CORS ───────────────────────────────────────────────────────────────────
# Allowed origin(s) for the REST API and Socket.io handshake.
# • Local dev:       http://localhost:8081
# • Android emu:     http://10.0.2.2:8081
# • Physical device: http://192.168.x.x:8081
# • Production:      * (mobile apps don't enforce CORS, so wildcard is fine)
# • Multiple origins: comma-separated — http://origin1.com,https://origin2.com
CLIENT_URL=http://localhost:8081

# ── Environment ────────────────────────────────────────────────────────────
# Set to "production" on Render
NODE_ENV=development
